
    @using System.Security.Claims
    @model IEnumerable<dineflow.Models.Menu>
@{
    ViewData["Title"] = "Point of Sale | DineFlow ";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var lastName = User.FindFirstValue(ClaimTypes.Name);  
}
<style>
    .product-card {
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        background-color: white;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        height: 250px; /* Fixed height for all cards */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    #product-list {
        max-height: 560px; /* Adjust this value as needed */
        overflow-y: auto; /* Enable vertical scrolling */
        display: flex;
        flex-wrap: wrap;
        gap: 30px; /* Add spacing between product cards */
        padding: 10px; /* Add padding for better spacing */
    }

        /* Custom scrollbar styling for #product-list */
        #product-list::-webkit-scrollbar {
            width: 8px; /* Width of the scrollbar */
            height: 8px; /* Height of the scrollbar (for horizontal scrollbars) */
        }


        #product-list::-webkit-scrollbar-track {
            background: transparent; /* Transparent background for the track */
        }


        #product-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.5); /* Semi-transparent scrollbar thumb */
            border-radius: 10px; /* Rounded corners for the thumb */
        }

            #product-list::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.9); /* Darker thumb on hover */
            }

    .product-card img {
        max-width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 10px;
    }

    .product-card h5 {
        font-size: 16px;
        margin: 10px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .order-details {
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #cart-items {
        max-height: 250px;
        overflow-y: auto;
        flex-grow: 1;
        border-bottom: 1px solid #ddd;
        padding-bottom: 10px;
    }

    .order-footer {
        padding-top: 10px;
        background: white;
    }

    .cart-table {
        overflow-y: auto;
        width: 100%;
        border-collapse: collapse;
    }

        .cart-table th, .cart-table td {
            padding: 8px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

    .quantity-btn {
        width: 25px;
        height: 25px;
        font-size: 14px;
        padding: 0;
    }

    .cc-orange {
        background-color: #F0A04B;
    }

    .cc-green {
        background-color: #B1C29E;
    }

    .cc-yellow {
        background-color: #FADA7A;
    }

    .cc-brown {
        background-color: #443627;
    }

    .cc-background {
        background-color: #FFF0DC;
    }

    .text-white {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .card {
        box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        margin-bottom: 20px;
    }

    .d-flex.overflow-auto::-webkit-scrollbar {
        height: 8px; /* Height of the scrollbar */
    }

    .d-flex.overflow-auto::-webkit-scrollbar-track {
        background: transparent; /* Transparent background */
    }

    .d-flex.overflow-auto::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.5); /* Semi-transparent scrollbar thumb */
        border-radius: 10px; /* Rounded corners */
    }


    .btn-green {
        background-color: #B1C29E;
        transition: all 0.3s ease-in-out;
    }

    .btn-green:hover {
        background-color: #626F47;
            transform: translateY(-3px); /* Moves the button up slightly */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2); /* Adds a shadow for depth */
    }

    .btn-yellow {
        background-color: #FADA7A;
        transition: all 0.3s ease-in-out;
    }

        .btn-yellow:hover {
            background-color: #F3CA52;
            transform: translateY(-3px); /* Moves the button up slightly */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2); /* Adds a shadow for depth */
        }

    .btn-orange {
        background-color: #F0A04B;
        transition: all 0.3s ease-in-out; /* Smooth transition */
    }

        .btn-orange:hover {
            background-color: #F0A04B;
            transform: translateY(-3px); /* Moves the button up slightly */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2); /* Adds a shadow for depth */
        }



        .d-flex.overflow-auto::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.9); /* Darker on hover */
        }

</style>

<div class="main card hero-header2">
    <div class="container-fluid">
        <div class="row">
            <!-- Product Section -->
            <div class="col-md-8">
                <div>
                    <div class="mt-4">
                        <!-- Add a container with horizontal scrolling -->
                        <div class="d-flex gap-2 overflow-auto" style="white-space: nowrap; overflow-x: auto; padding-bottom: 10px;">
                            <button class="btn cc-orange btn-sm text-light" onclick="filterProducts('All')">All</button>
                            @foreach (var category in ViewBag.Categories as List<string>)
                            {
                                <button class="btn cc-orange btn-sm text-light" onclick="filterProducts('@category')">@category</button>
                            }
                        </div>
                    </div>
                </div>
                <h3 class="text-white mb-2">Products</h3>
                <div class="row g-2" id="product-list">
                    @foreach (var product in Model)
                    {

                        <div class="col-md-2 product-item" data-category="@product.Category.Name">
                            @* <a onclick="addToCart(@product.Id, '@product.Name', @product.Price)" style="cursor:pointer"> *@
                            <div class="product-card p-2">
                                @if (product.ImageBytes != null)
                                {
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(product.ImageBytes)"
                                         alt="@product.Name"
                                         class="img-fluid"
                                         style="max-height: 150px; width: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <!-- Placeholder if no image exists -->
                                    <div class="text-center py-3 bg-light">
                                        <span>No Image</span>
                                    </div>
                                }                                
                                <h5 title="@product.Name">@(product.Name.Length > 20 ? product.Name.Substring(0, 20) + "..." : product.Name)</h5>
                                <p>₱@product.Price</p>
                                    <button class="btn btn-green btn-sm text-dark" onclick="addToCart(@product.Id, '@product.Name', @product.Price)">Add</button>
                            </div>

                        </div>
                        
                    }
                </div>
            </div>

            <!-- Cart Section -->
            <div class="col-md-4 mt-3  d-flex flex-column">
                <div class="order-details">
                    <h4>Order Details</h4>
                    <div class="cart-container" style="min-height:300px;max-height:300px; overflow-y:auto;">
                        <!-- Added wrapper for scrollable cart -->
                        <table class="cart-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items"></tbody>
                        </table>
                    </div>
                    <div class="order-footer">
                        <h4>Total: <span style="margin-right: 200px"></span>₱<span id="total">0</span></h4>
                        <div class="mb-2">Table: <input type="number" class="form-control" id="table-input"></div>
                        <div class="mb-2">Cash: <input type="number" class="form-control" id="cash-input" oninput="calculateChange()"></div>
                        <div class="mb-2">Change: ₱<span id="change">0.00</span></div>
                        <input type="hidden" id="reservation-id" value="@ViewBag.ReservationId">

                        <input type="hidden" id="userid"value="@userId"/>
                        <button class="btn btn-success  w-100 mt-2" onclick="checkout()">Checkout</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
    let cart = JSON.parse(localStorage.getItem('cart')) || [];

    function addToCart(menuitemid, name, price) {
        let existing = cart.find(item => item.menuitemid === menuitemid);
        if (existing) {
            existing.quantity++;
        } else {
            cart.push({ menuitemid, name, price, quantity: 1 });
        }
        saveCart();
        updateCart();
    }

    function removeFromCart(menuitemid) {
        cart = cart.filter(item => item.menuitemid !== menuitemid);
        saveCart();
        updateCart();
    }

    function changeQuantity(menuitemid, delta) {
        let item = cart.find(item => item.menuitemid === menuitemid);
        if (item) {
            item.quantity += delta;
            if (item.quantity <= 0) {
                removeFromCart(menuitemid);
            }
        }
        saveCart();
        updateCart();
    }

    function updateCart() {
        let cartItems = document.getElementById('cart-items');
        let total = 0;
        cartItems.innerHTML = '';

        cart.forEach(item => {
            total += item.price * item.quantity;
            cartItems.innerHTML += `
                <tr>
                    <td style="max-width:100px;"><p>${item.name}</p></td>
                    <td>
                        <button class="btn btn-sm btn-secondary quantity-btn" onclick="changeQuantity(${item.menuitemid}, -1)">-</button>
                        ${item.quantity}
                        <button class="btn btn-sm btn-secondary quantity-btn" onclick="changeQuantity(${item.menuitemid}, 1)">+</button>
                    </td>
                    <td>₱${(item.price * item.quantity).toFixed(2)}</td>
                    <td><button class="btn btn-danger btn-sm" onclick="removeFromCart(${item.menuitemid})">X</button></td>
                </tr>`;
        });

        document.getElementById('total').innerText = total.toFixed(2);
        calculateChange();
    }

    function calculateChange() {
        let cashInput = parseFloat(document.getElementById("cash-input").value) || 0;
        let total = parseFloat(document.getElementById("total").innerText);
        let change = cashInput - total;
        document.getElementById("change").innerText = change > 0 ? change.toFixed(2) : "0.00";
    }

    function saveCart() {
        localStorage.setItem('cart', JSON.stringify(cart));
    }

    function checkout() {
        if (cart.length === 0) {
            alert("Cart is empty!");
            return;
        }

        const orderData = {
            reservationId: document.getElementById("reservation-id").value ? parseInt(document.getElementById("reservation-id").value) : null,
            tableId: parseInt(document.getElementById("table-input").value) || null,
            userId: document.getElementById("userid").value,
            status: "Preparing",
            cart: cart
        };

        fetch('/Orders/Checkout', {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(orderData)
        })
        .then(response => response.json())
        .then(data => {
            alert(`Order placed! Transaction ID: ${data.transactionId}`);
            generateReceipt(data.transactionId,parseFloat(document.getElementById("cash-input").value));
            cart = [];
            saveCart();
            updateCart();
            const url = new URL(window.location.href);
            url.searchParams.delete('reservationId');
            window.location.href = url.toString();
        })
        .catch(error => console.error("Error:", error));
    }

         function generateReceipt(transactionId,cash) {

        const doc = new jspdf.jsPDF();

        // Business Information
        const businessName = "DineFlow Restaurant";
        const businessAddress = "123 Main Street, City, Country";
        const businessPhone = "Phone: (+63)966 759 2570";
        const businessEmail = "dineflow0310@gmail.com";

        // Set font and size for the header
        doc.setFontSize(20);
        doc.setFont("helvetica", "bold");
        doc.text(businessName, 10, 15);

        // Set font and size for the address
        doc.setFontSize(12);
        doc.setFont("helvetica", "normal");
        doc.text(businessAddress, 10, 25);
        doc.text(businessPhone, 10, 30);
        doc.text(businessEmail, 10, 35);

        // Add a horizontal line
        doc.setLineWidth(0.5);
        doc.line(10, 40, 200, 40);

        // Transaction ID
        doc.setFontSize(14);
        doc.text(`Transaction ID: ${transactionId}`, 10, 50);

        // Get current date and time
        const now = new Date();
        const formattedDate = `${now.getMonth() + 1}/${now.getDate()}/${now.getFullYear().toString().slice(-2)}`; // M/dd/yy
        const formattedTime = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`; // hh:mm

        // Add date and time
        doc.text(`Date: ${formattedDate}`, 10, 60);
        doc.text(`Time: ${formattedTime}`, 10, 65);

        // Add a horizontal line
        doc.line(10, 70, 200, 70);

        // Table Headers
        doc.setFontSize(12);
        doc.setFont("helvetica", "bold");
        doc.text("Item", 10, 80); // Item column
        doc.text("Qty", 70, 80); // Quantity column
        doc.text("Price", 100, 80); // Price per item column
        doc.text("Total", 150, 80); // Total price column

        // Add a horizontal line
        doc.line(10, 85, 200, 85);

        // Table Rows
        doc.setFontSize(12);
        doc.setFont("Arial Unicode MS", "normal");
        let startY = 95; // Starting Y position for table rows
        let total = 0;

        cart.forEach(item => {
            const itemTotal = item.price * item.quantity;
            total += itemTotal;

            doc.text(item.name, 10, startY);
             startY += 10;
            // Item name
            doc.text(item.menuitemid.toString(), 10, startY);

            // Quantity
            doc.text(item.quantity.toString(), 70, startY);

            // Price per item
            doc.text(` ${item.price.toFixed(2)}`, 100, startY); // Changed ₱ to ±

            // Total price for the item
            doc.text(` ${itemTotal.toFixed(2)}`, 150, startY); // Changed ₱ to ±


            startY += 10; 
           
            
        });

        // Add a horizontal line
        doc.line(10, startY, 200, startY);
        const change = cash - total;
        // Total
        doc.setFontSize(20);
        doc.setFont("DejaVuSans", "bold");
        doc.text(`Total:`, 10, startY + 10); // Changed ₱ to ±
        doc.text(`${total.toFixed(2)}`,150 ,startY +10);
        doc.setFontSize(14);
        doc.setFont("DejaVuSans", "normal");
        doc.text(`Cash:`, 10, startY + 15); // Display cash
        doc.text(`${cash.toFixed(2)}`,150,startY + 15);
        doc.text(`Change: `, 10, startY + 20); // Display change
        doc.text(`${change.toFixed(2)}`,150, startY +20);
       
        
        doc.line(10, startY + 25, 200, startY + 25);

         startY +=30;
        // Footer
        doc.setFontSize(10);
        doc.setFont("helvetica", "normal");
        doc.text("Thank you for dining with us!", 10, startY );
        doc.text("Visit us again soon!", 10, startY + 10);

        // Save and open PDF in a new tab
        doc.save(`receipt_${transactionId}.pdf`); // Save the PDF
        window.open(doc.output('bloburl'), '_blank'); // Open in a new tab
    }

    function filterProducts(category) {
        document.querySelectorAll('.product-item').forEach(item => {
            if (category === 'All' || item.getAttribute('data-category') === category) {
                item.style.display = "block";
            } else {
                item.style.display = "none";
            }
        });
    }

    updateCart();
</script>
