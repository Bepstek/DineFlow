@model IEnumerable<dineflow.Models.Transaction>

@{
    ViewData["Title"] = "Transactions";
}

<div class="main p-4">
    <h3 class="mb-4">Transaction Records</h3>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Transaction ID</th>
                    <th>User</th>
                    <th>Date</th>
                    <th>Order ID</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TransactionId</td>
                        <td>@item.UserId</td>
                        <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@item.OrderId</td>
                        <td>@item.TotalAmount.ToString("C")</td>
                        <td>@item.Status</td>
                        <td>
                            <button class="btn btn-info view-details" data-id="@item.TransactionId" data-bs-toggle="modal" data-bs-target="#transactionModal">Details</button>
                            @if (item.Status != "Complete" && item.Status != "Preparing")
                            {
                                <span>|</span>
                                <a class="btn btn-warning" asp-action="CompleteTransaction" asp-route-id="@item.TransactionId">Complete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Transaction Details Modal -->
<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="transactionModalLabel">Transaction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Transaction ID:</strong> <span id="modalTransactionId"></span></p>
                <hr>
                <h6>Transaction Items:</h6>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="modalTransactionItems">
                        <tr>
                            <td colspan="4" class="text-center">No items available</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
       document.addEventListener("DOMContentLoaded", function () {
        // Handle "Details" button click
        document.querySelectorAll(".view-details").forEach(button => {
            button.addEventListener("click", function () {
                let transactionId = this.getAttribute("data-id");
                console.log("Fetching details for Transaction ID:", transactionId);

                // Fetch transaction details
                fetch(`/Dashboard/GetTransactionDetails?id=${transactionId}`)
                    .then(response => {
                        console.log("Response:", response);
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log("Data:", data);
                        // Populate modal with transaction details
                        document.getElementById("modalTransactionId").innerText = data.transactionId;
                        // Populate transaction items
                        let itemsBody = document.getElementById("modalTransactionItems");
                        itemsBody.innerHTML = ""; // Clear existing rows

                        if (data.items && data.items.length > 0) {
                            data.items.forEach(item => {
                                let newRow = itemsBody.insertRow();
                                newRow.innerHTML = `
                                    <td>${item.itemName}</td>
                                    <td>${item.quantity}</td>
                                    <td>${item.price}</td>
                                    <td>${item.total}</td>
                                `;
                            });
                        } else {
                            itemsBody.innerHTML = `<tr><td colspan="4" class="text-center">No items available</td></tr>`;
                        }
                    })
                    .catch((error) => {
                        console.error('Error:', error);
                        alert("An error occurred while fetching transaction details.");
                    });
            });
        });
    });
</script>