@model IEnumerable<dineflow.Models.Menu>
@{
    ViewData["Title"] = "Menu Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-xxl bg-white p-0">
    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <!-- Spinner End -->
    <!-- Navbar & Hero Start -->
    <div class="container-xxl position-relative p-0">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 px-lg-5 py-3 py-lg-0">
            <a class="navbar-brand d-flex align-items-center p-0" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.png" alt="Logo" style="height: 80px; width: auto; margin-right: 10px;">
                <h1 class="text-primary m-0"><i></i>DineFlow</h1>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0 pe-4">
                    <a class="nav-item nav-link " asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-item nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                    @* <a class="nav-item nav-link" asp-area="" asp-controller="Home" asp-action="Service">Service</a> *@
                    <a class="nav-item nav-link active" asp-area="" asp-controller="Home" asp-action="Menu">Menu</a>
                  
                </div>
                <a class="btn btn-primary py-2 px-4" asp-area="" asp-controller="Home" asp-action="Booking">Reserve A Table</a>
            </div>
        </nav>

        <div class="container-xxl py-5 bg-dark hero-header mb-5">
            <div class="container text-center my-5 pt-5 pb-4">
                <h1 class="display-3 text-white mb-3 animated slideInDown">Food Menu</h1>
                @* <nav aria-label="breadcrumb"> *@
                @*     <ol class="breadcrumb justify-content-center text-uppercase"> *@
                @*         <li class="breadcrumb-item"><a href="#">Home</a></li> *@
                @*         <li class="breadcrumb-item"><a href="#">Pages</a></li> *@
                @*         <li class="breadcrumb-item text-white active" aria-current="page">Menu</li> *@
                @*     </ol> *@
                @* </nav> *@
            </div>
        </div>
    </div>
    <!-- Navbar & Hero End -->
    <!-- Menu Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h5 class="section-title ff-secondary text-center text-primary fw-normal">Food Menu</h5>
                <h1 class="mb-5">Most Popular Items</h1>
            </div>
            <div class="tab-class text-center wow fadeInUp" data-wow-delay="0.1s">
                <ul class="nav nav-pills d-inline-flex justify-content-center border-bottom mb-5">
                    @{
                        var firstCategory = true; // Flag to track the first category
                    }
                    @foreach (var category in ViewBag.Categories as List<string>)
                    {
                        <li class="nav-item">
                            <a class="d-flex align-items-center text-start mx-3 pb-3 @(firstCategory ? "active" : "")"
                               data-bs-toggle="pill" href="#tab-@category.ToLower().Replace(" ", "-")">
                                <i class="fa fa-utensils fa-2x text-primary"></i>
                                <div class="ps-3">
                                    <small class="text-body">Category</small>
                                    <h6 class="mt-n1 mb-0">@category</h6>
                                </div>
                            </a>
                        </li>
                        firstCategory = false; // Set to false after first iteration
                    }
                </ul>

                <div class="tab-content">
                    @{
                        var firstTab = true; // Track first tab
                    }
                    @foreach (var category in ViewBag.Categories as List<string>)
                    {
                        <div id="tab-@category.ToLower().Replace(" ", "-")" class="tab-pane fade @(firstTab ? "show active" : "") p-0">
                            <div class="row g-4">
                                @foreach (var item in Model.Where(m => m.Category.Name == category).Take(10))
                                {
                                    <div class="col-lg-6">
                                        <div class="d-flex align-items-center">
                                            @if (item.ImageBytes != null)
                                            {
                                                <img class="flex-shrink-0 img-fluid rounded"
                                                     src="data:image/jpeg;base64,@Convert.ToBase64String(item.ImageBytes)"
                                                     alt="@item.Name"
                                                     style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #FEA116;" />
                                            }
                                            else
                                            {
                                               
                                                <div class="flex-shrink-0 img-fluid rounded"
                                                     style="width: 100px; height: 100px; border: 1px solid #FEA116; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                                                    <span class="text-muted">No Image</span>
                                                </div>
                                            }
                                            <div class="w-100 d-flex flex-column text-start ps-4">
                                                <h5 class="d-flex justify-content-between border-bottom pb-2">
                                                    <span>@item.Name</span>
                                                    <span class="text-primary">$@item.Price.ToString("N2")</span>
                                                </h5>
                                                <small class="fst-italic">@item.Description</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        firstTab = false; // Set to false after first tab
                    }
                </div>

            </div>
        </div>
    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Select the first tab and activate it
        let firstTab = document.querySelector(".nav-pills .nav-item a");
        if (firstTab) {
            new bootstrap.Tab(firstTab).show();
        }
    });
</script>
