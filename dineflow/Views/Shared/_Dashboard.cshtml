<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="icon" href="~/img/logo.png" />
    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" href="~/img/logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Nunito:wght@600;700;800&family=Pacifico&display=swap" rel="stylesheet">

    <!-- Icon Fonts -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- CSS Libraries -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/animate/animate.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/owlcarousel/assets/owl.carousel.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" asp-append-version="true" />

    <!-- Custom Stylesheets -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dineflow.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid p-0 d-flex">
        <aside id="sidebar">
            <div class="d-flex">
                <button class="toggle-btn" type="button">
                    <img src="~/img/logo.png" alt="Logo" style="height: 60px; width: auto; margin-right:30px">
                </button>
                <div class="sidebar-logo">
                    <h4 class="text-primary">DineFlow</h4>
                </div>
            </div>
            <ul class="sidebar-nav">
                <li class="sidebar-item">
                    <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Dashboard" asp-action="Index">
                        <i class="lni lni-dashboard"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Dashboard" asp-action="Pos">
                        <i class="lni lni-cart"></i>
                        <span>POS</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Dashboard" asp-action="Reservation">
                        <i class="lni lni-calendar"></i>
                        <span>Reservation</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Dashboard" asp-action="Transaction">
                        <i class="lni lni-stats-up"></i>
                        <span>Transaction</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Dashboard" asp-action="Inventory">
                        <i class="lni lni-archive"></i>
                        <span>Inventory</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link collapsed has-dropdown btn link-primary  text-start" data-bs-toggle="collapse"
                       data-bs-target="#admin-monitor" aria-expanded="false" aria-controls="admin-monitor">
                        <i class="lni lni-display"></i>
                        <span>Monitors</span><i class="lni lni-chevron-down" style="margin-left:100px; " ></i>
                    </a>
                    <ul id="admin-monitor" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                        <li class="sidebar-item">
                            <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Monitors" asp-action="Kitchen" target="_blank">
                                <i class="lni lni-dinner"></i>
                                Kitchen
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Monitors" asp-action="Orders">
                                <i class="lni lni-library"></i>
                                Orders
                            </a>
                        </li>
                    </ul
                    >
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="sidebar-item">
                        <a href="#" class="sidebar-link collapsed has-dropdown btn link-primary  text-start" data-bs-toggle="collapse"
                           data-bs-target="#admin-dropdown" aria-expanded="false" aria-controls="admin-dropdown">
                            <i class="lni lni-cog"></i>
                            <span>Admin</span><i class="lni lni-chevron-down" style="margin-left:114px; "></i>
                        </a>
                        
                        <ul id="admin-dropdown" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                            <li class="sidebar-item">
                                <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Admin" asp-action="Management">
                                    <i class="lni lni-users"></i>
                                    Management
                                </a>
                            </li>
                            @* <li class="sidebar-item"> *@
                            @*     <a class="sidebar-link" asp-area="" asp-controller="Admin" asp-action="Table"> *@
                            @*         <i class="lni lni-grid-alt"></i> *@
                            @*         Table *@
                            @*     </a> *@
                            @* </li> *@
                            <li class="sidebar-item">
                                <a class="sidebar-link btn link-primary  text-start" asp-area="" asp-controller="Admin" asp-action="Menu">
                                    <i class="lni lni-package"></i>
                                    Menu
                                </a>

                            </li>
                            @* <li class="sidebar-item"> *@
                            @*     <a class="sidebar-link" asp-area="" asp-controller="Admin" asp-action="Settings"> *@
                            @*         <i class="lni lni-cog"></i> *@
                            @*         Settings *@
                            @*     </a> *@
                            @* </li> *@
                        </ul>
                    </li>
                }
            </ul>

            <div class="sidebar-footer">
                <a class="sidebar-link btn link-primary  text-start" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="lni lni-user"></i>
                    <span>@User.Identity?.Name</span>
                </a>
            </div>

            <div class="sidebar-footer">
                <a class="sidebar-link btn link-primary  text-start" href="#" onclick="document.getElementById('logoutForm').submit(); return false;">
                    <i class="lni lni-exit"></i>
                    <span>Logout</span>
                </a>
                <form id="logoutForm" method="post" asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="display: none;">
                    <button type="submit"></button>
                </form>
            </div>
        </aside>

        <div class="bg-light flex-fill">
            <div class="p-1">
                <div class="row">
                    <div>
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe"
            crossorigin="anonymous"></script>

    <script>
        document.querySelector(".toggle-btn").addEventListener("click", function () {
            document.querySelector("#sidebar").classList.toggle("expand");
        });
    </script>
</body>
</html>
