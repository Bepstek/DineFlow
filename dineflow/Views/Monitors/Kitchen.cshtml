@model IEnumerable<dineflow.Models.Transaction>

@{
    ViewData["Title"] = "Kitchen Monitor";
    
    var preparingOrders = Model.Where(t => t.Status == "Preparing").ToList();
}
<style>
    .btn-green {
        background-color: #B1C29E;
        transition: all 0.3s ease-in-out;
    }

        .btn-green:hover {
            background-color: #626F47;
            transform: translateY(-3px); /* Moves the button up slightly */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2); /* Adds a shadow for depth */
        }

    .btn-yellow {
        background-color: #FADA7A;
        transition: all 0.3s ease-in-out;
    }

        .btn-yellow:hover {
            background-color: #F3CA52;
            transform: translateY(-3px); /* Moves the button up slightly */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2); /* Adds a shadow for depth */
        }

    .btn-orange {
        background-color: #F0A04B;
        transition: all 0.3s ease-in-out; /* Smooth transition */
    }

        .btn-orange:hover {
            background-color: #F0A04B;
            transform: translateY(-3px); /* Moves the button up slightly */
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2); /* Adds a shadow for depth */
        }


</style>
<div class="container main p-4 hero-header3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a asp-controller="Admin" asp-action="Settings">
                <i class="lni lni-arrow-left mx-5 text-dark "></i>
            </a>
            <h3 class="text-dark mb-0"><i class="lni lni-restaurant"></i> Kitchen Monitor</h3>
        </div>
        <h4 class="text-secondary">Orders: <span class="badge bg-dark">@preparingOrders.Count</span></h4>
    </div>
    <hr>

    <!-- Scrollable Order List -->
    <div class="scrollable-container ">
        <div class="row">
            @foreach (var item in preparingOrders)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg">
                        <div class="card-header bg-dark text-white text-center">
                            <h5 class="mb-0 text-white">Order: @item.OrderId</h5>
                        </div>
                        <div class="card-body">
                            
                            <p><strong>Order Date:</strong> @item.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")</p>
                            <p><strong>Status:</strong> <span class="badge status">@item.Status</span></p>
                            <hr>
                            <h6>Items:</h6>
                            <ul class="list-group">
                                @foreach (var detail in item.TransactionDetails)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@detail.MenuItem.Name</span>
                                        <span class="badge bg-primary rounded-pill">x @detail.Quantity</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="card-footer text-center">
                            <a class="btn btn-yellow preparing btn-sm update-status"
                               asp-action="ServingOrder"
                               asp-route-id="@item.TransactionId"
                               onclick="event.preventDefault(); handleConfirmation(this, @item.TransactionId);">
                                <i class="lni lni-checkmark-circle"></i> Done Preparing
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Scrollable Order List */
    .scrollable-container {
        max-height: 80vh; /* Adjust as needed */
        overflow-y: auto;
        padding-right: 10px;
    }

        .scrollable-container::-webkit-scrollbar {
            width: 8px; /* Set scrollbar width */
        }

        .scrollable-container::-webkit-scrollbar-track {
            background: #f1f1f1; /* Light grey background */
            border-radius: 10px;
        }

        .scrollable-container::-webkit-scrollbar-thumb {
            background: #888; /* Darker grey scrollbar */
            border-radius: 10px;
        }

            .scrollable-container::-webkit-scrollbar-thumb:hover {
                background: #555; /* Even darker on hover */
            }

    .hero-header3 {
        background: linear-gradient(rgba(252, 231, 200, .8), rgba(252, 231, 200, .8)), url(../img/bg-1.jpg);
        background-position: center center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .status {
        background-color: #B1C29E;
    }

    .preparing {
        background-color: #FADA7A;
    }
</style>


<script>
    function confirmArchive(orderid) {
        return new Promise((resolve) => {
            // Check if confirmation box already exists
            if (document.getElementById("confirmDiv")) return;

            // Create confirmation div
            let confirmDiv = document.createElement("div");
            confirmDiv.id = "confirmDiv";
            confirmDiv.style.position = "fixed";
            confirmDiv.style.top = "50%";
            confirmDiv.style.left = "50%";
            confirmDiv.style.transform = "translate(-50%, -50%)";
            confirmDiv.style.background = "white";
            confirmDiv.style.padding = "20px";
            confirmDiv.style.border = "1px solid black";
            confirmDiv.style.boxShadow = "0px 4px 6px rgba(0,0,0,0.1)";
            confirmDiv.style.zIndex = "1000";
            confirmDiv.innerHTML = `
                <p style="text-align:center; font-size:18px;">Are all food items in order #${orderid} ready to be served?</p>
                <div style="text-align:center;">
                    <button id="confirmYes" class="btn btn-success">Yes</button>
                    <button id="confirmNo" class="btn btn-danger">No</button>
                </div>
            `;
            document.body.appendChild(confirmDiv);

            // Handle button clicks
            document.getElementById("confirmYes").onclick = function () {
                document.body.removeChild(confirmDiv);
                resolve(true);
            };
            document.getElementById("confirmNo").onclick = function () {
                document.body.removeChild(confirmDiv);
                resolve(false);
            };
        });
    }

    async function handleConfirmation(button, orderid) {
        const confirmed = await confirmArchive(orderid);
        if (confirmed) {
            window.location.href = button.href;
        }
    }

</script>
