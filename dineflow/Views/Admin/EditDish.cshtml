@model dineflow.Models.Menu

@{
    ViewData["Title"] = "EditDish";
}
<div class="main">
<h1>EditDish</h1>

<h4>Menu</h4>
<hr />
<div class="row">
    <div class="col-md-4">
            <form asp-action="EditDish" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="form-group">
                    <label for="Name">Dish Name</label>
                    <input type="text" name="Name" class="form-control" value="@Model.Name" required />
                </div>

                <div class="form-group">
                    <label for="CategoryId">Category</label>
                    <select name="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                </div>

                <div class="form-group">
                    <label for="Description">Description</label>
                    <input type="text" name="Description" class="form-control" value="@Model.Description" required />
                </div>

                <div class="form-group">
                    <label for="Price">Price</label>
                    <input type="number" step="0.01" name="Price" class="form-control" value="@Model.Price" required />
                </div>

                <div class="form-group">
                    <label for="ImageBase64">Dish Image</label>
                    <input type="file" name="ImageBase64" class="form-control" />
                </div>

                

                <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>

    </div>
    <div class="col-md-8 d-flex justify-content-center align-items-center">
        @if (!string.IsNullOrEmpty(Model.ImageBase64))
        {
            <img src="~/dishimage/@Model.ImageBase64" class="rounded-circle" width="300" height="300" asp-append-version="true" />
        }
    </div>

</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
</div>