@model IEnumerable<dineflow.Models.Menu>

@{
    ViewData["Title"] = "Menu";
}
<div class="main">
<h1>Menu</h1>

<p>
    <a asp-action="CreateDish">Add new dish</a> | <a asp-action="Categories">Category</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.IsArchived)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category.Name)
                </td>
               
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                
                <td>
                    @Html.DisplayFor(modelItem => item.IsArchived)
                </td>
                <td>
                   
                    <a class="btn btn-primary" asp-action="EditDish" asp-route-id="@item.Id">Edit</a> |
                    <a class="btn btn-secondary" asp-action="DetailDish" asp-route-id="@item.Id">Details</a> |
                    @if (!item.IsArchived)
                    {
                        <a class="btn btn-warning" asp-action="ArchiveDish" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to archive this dish?')">Archive</a>

                    }
                    else
                    {
                        <a class="btn btn-success" asp-action="UnarchiveDish" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to restore this dish?')">Unarchive</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>