@model IEnumerable<dineflow.Models.Menu>

@{
    ViewData["Title"] = "Menu";
}

<div class="main">

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            
            <p>
                <a class="btn btn-success" asp-action="CreateDish">Add new dish</a> |
                <a class="btn btn-info" asp-action="Categories">Category</a>
            </p>
            <form method="get" asp-action="Menu" class="d-flex" id="searchForm">
                <input type="text" name="search" value="@ViewBag.SearchQuery" class="form-control mb-3" placeholder="Search menu items..." />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Name)</th>
                                <th>@Html.DisplayNameFor(model => model.Category)</th>
                                <th>@Html.DisplayNameFor(model => model.Price)</th>
                                <th>@Html.DisplayNameFor(model => model.IsArchived)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                    <td>@Html.DisplayFor(modelItem => item.IsArchived)</td>
                                    <td>
                                        <a class="btn btn-primary" asp-action="EditDish" asp-route-id="@item.Id">Edit</a> |
                                        <a class="btn btn-secondary" asp-action="DetailDish" asp-route-id="@item.Id">Details</a> |
                                        @if (!item.IsArchived)
                                        {
                                            <a class="btn btn-warning" asp-action="ArchiveDish" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to archive this dish?')">Archive</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-success" asp-action="UnarchiveDish" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to restore this dish?')">Unarchive</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav>
                            <ul class="pagination">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Menu", new { search = ViewBag.SearchQuery, page = i })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>  
</div>
