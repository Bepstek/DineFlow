@model IEnumerable<dineflow.Models.Menu>

@{
    ViewData["Title"] = "Menu";
    int pageNumber = ViewBag.PageNumber;
    int pageSize = ViewBag.PageSize;
    int totalItems = ViewBag.TotalItems;
    int totalPages = ViewBag.TotalPages;
    
}
   


<div class="main">
    <div class="container mt-4">
       
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p>
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addDishModal">Add new dish</button> |
                <a class="btn btn-info" asp-action="Categories">Category</a>
            </p>
            <form method="get" asp-action="Menu" class="d-flex" id="searchForm">
                <input type="text" name="search" value="@ViewBag.SearchQuery"
                       placeholder="Search menu items..." class="form-control me-2" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th></th>
                                <th>@Html.DisplayNameFor(model => model.Name)</th>
                                <th>@Html.DisplayNameFor(model => model.Category)</th>
                                <th>@Html.DisplayNameFor(model => model.Price)</th>
                                <th>@Html.DisplayNameFor(model => model.IsArchived)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @* <td><img src="~/dishimage/@item.ImageBase64" class="img-fluid" width="100px" style="max-height:100px" asp-append-version="true" /></td> *@
                                    <td>
                                        @if (item.ImageBytes != null)
                                        {
                                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.ImageBytes)"
                                                 class="img-fluid"
                                                 width="100px"
                                                 style="max-height:100px"
                                                 asp-append-version="true" />
                                        }
                                        else
                                        {
                                            <span>No Image</span>
                                        }
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                                        <td>₱ @Html.DisplayFor(modelItem => item.Price)</td>
                                    <td>@(item.IsArchived ? "True" : "False")</td>
                                    <td>
                                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editDishModal" data-id="@item.Id">Edit</button> |
                                       
                                        @if (!item.IsArchived)
                                        {
                                            <a class="btn btn-warning" asp-action="ArchiveDish" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to archive this dish?')">Archive</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-success" asp-action="UnarchiveDish" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to restore this dish?')">Unarchive</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Menu" asp-route-page="@i" asp-route-search="@ViewBag.SearchString">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
            
        </div>
    </div>
</div>

<!-- Add Dish Modal -->
<div class="modal fade" id="addDishModal" tabindex="-1" aria-labelledby="addDishModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDishModalLabel">Add New Dish</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="CreateDish" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Category</label>
                        <select class="form-select" name="CategoryId" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))" required>
                            <option value="">-- Select a Category --</option>
                        </select>
                        <span class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" class="form-control" name="Description" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Price</label>
                        <input type="number" class="form-control" name="Price" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        <input type="file" class="form-control" name="ImageFile" accept="image/*" />
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editDishModal" tabindex="-1" aria-labelledby="editDishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editDishModalLabel">Edit Dish</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editDishForm" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-lg-7">
                            <input type="hidden" name="Id" id="editDishId">
                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input type="text" class="form-control" name="Name" id="editDishName" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" name="CategoryId" id="editDishCategory" required>
                                    <option value="">-- Select a Category --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <input type="text" class="form-control" name="Description" id="editDishDescription" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Price</label>
                                <input type="number" class="form-control" name="Price" id="editDishPrice" step="0.01" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Image</label>
                                <input type="file" class="form-control" name="ImageFile" id="editDishImage" accept="image/*" />

                            </div>
                                    
                        </div>
                        <div class="col-lg-5 col-md-5 col-sm-5 text-center mt-4">
                            <div class="card p-2 shadow">
                                <img id="currentDishImage" src="#" alt="Current Image" class="img-fluid mt-2" style="height: 350px; display: none;" />

                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Handle the modal opening event
            $('#editDishModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget); // Button that triggered the modal
        var dishId = button.data('id'); // Extract info from data-* attributes

        // Fetch the dish data using AJAX
        $.ajax({
            url: '/Admin/GetDishById', // Replace with your actual endpoint
            type: 'GET',
            data: { id: dishId },
            success: function (data) {
                // Populate the form fields with the fetched data
                $('#editDishId').val(data.id);
                $('#editDishName').val(data.name);
                $('#editDishDescription').val(data.description);
                $('#editDishPrice').val(data.price);

                // Populate the category dropdown
                var categoryDropdown = $('#editDishCategory');
                categoryDropdown.empty();
                categoryDropdown.append($('<option>', {
                    value: '',
                    text: '-- Select a Category --'
                }));

                // Add all categories to the dropdown
                data.categories.forEach(function (category) {
                    categoryDropdown.append($('<option>', {
                        value: category.id,
                        text: category.name
                    }));
                });

                // Set the selected category
                categoryDropdown.val(data.category.id);

                // Display the current image if it exists
                if (data.imageUrl) {
                    $('#currentDishImage').attr('src', 'data:image/jpeg;base64,' + data.imageUrl).show();
                } else {
                    $('#currentDishImage').hide();
                }
            },
            error: function (xhr, status, error) {
                console.error('Error fetching dish data:', error);
            }
        });
    });

        // Handle form submission
            $('#editDishForm').on('submit', function (e) {
        e.preventDefault(); // Prevent the default form submission

        var formData = new FormData(this);

        // Log form data
        for (var pair of formData.entries()) {
            console.log(pair[0] + ', ' + pair[1]);
        }

        $.ajax({
            url: '/Admin/UpdateDish', // Replace with your actual endpoint
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    location.reload(); // Reload the page to reflect changes
                } else {
                    alert('Error updating dish: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error('Error updating dish:', error);
            }
        });
    });
    });
</script>


