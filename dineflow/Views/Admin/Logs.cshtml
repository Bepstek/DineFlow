@model IEnumerable<dineflow.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs | DineFlow";
    int pageNumber = ViewBag.PageNumber;
    int pageSize = ViewBag.PageSize;
    int totalItems = ViewBag.TotalItems;
    int totalPages = ViewBag.TotalPages;
}

<div class="main p-2">
    <h3 class="mb-4"></h3>

    <div class="container mt-4">
        <!-- Title & Search Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Activity Logs</h5>
            <form method="get" asp-action="Logs" class="d-flex">
                <input type="text" name="searchString" value="@ViewBag.SearchString"
                       placeholder="Search logs..." class="form-control me-2" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Log ID</th>
                                <th>User ID</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@log.LogId</td>
                                    <td>@log.UserId</td>
                                    <td>@log.Action</td>
                                    <td>@log.Details</td>
                                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div> <!-- End of table-responsive -->
                <!-- Pagination -->
                <div class="d-flex justify-content-center">
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == pageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Logs" asp-route-pageNumber="@i" asp-route-searchString="@ViewBag.SearchString">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>