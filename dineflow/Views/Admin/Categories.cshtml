@model List<dineflow.ViewModel.CategoryViewModel>

@{
    ViewData["Title"] = "Category | DineFlow";
}

<div class="main">
    <div class="container mt-2">
        <!-- Title & Search Bar -->
        <div class="mb-3">
            <a asp-action="Menu" class="btn btn-secondary">Back to Menu</a>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Manage Categories</h5>
            <form method="get" asp-action="Categories" class="d-flex">
                <input type="text" name="search" value="@ViewBag.SearchQuery"
                       placeholder="Search categories..." class="form-control me-2" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>

        <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            Add New Category
        </button>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Dishes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.Name</td>
                                    <td>@category.DishCount</td>
                                    <td>
                                        <button class="btn btn-primary" data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal"
                                                onclick="editCategory('@category.Id', '@category.Name')">
                                            Edit
                                        </button>

                                        @if (!category.IsArchived)
                                        {
                                            <a class="btn btn-warning"
                                               asp-action="ArchiveCategory"
                                               asp-route-id="@category.Id"
                                               onclick="return confirmArchive(@category.DishCount)">
                                                Archive
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-success"
                                               asp-action="UnarchiveCategory"
                                               asp-route-id="@category.Id"
                                               onclick="return confirm('Are you sure you want to restore this category?')">
                                                Unarchive
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCategoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="CreateCategory" method="post" asp-controller="Admin">
                    <div class="mb-3">
                        <label for="Name" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" required>
                        <input type="hidden" name="IsArchived" value="false" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCategoryModalLabel">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCategoryForm" asp-action="EditCategory" method="post">
                    <input type="hidden" id="editCategoryId" name="Id">
                    <div class="mb-3">
                        <label for="editCategoryName" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="editCategoryName" name="Name" required>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmArchive(dishCount) {
        return confirm(`Are you sure you want to archive this category? ${dishCount} dishes use this category.`);
    }

    function editCategory(id, name) {
        document.getElementById('editCategoryId').value = id;
        document.getElementById('editCategoryName').value = name;
    }
</script>