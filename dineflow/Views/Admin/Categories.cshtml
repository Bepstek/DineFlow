@model List<dineflow.ViewModel.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}
<div class="main"> 
<h2>Manage Categories</h2>

<!-- Search Form -->
<form method="get" asp-action="Categories" id="searchForm">
    <input type="text" name="search" value="@ViewBag.SearchQuery" class="form-control mb-3" placeholder="Search categories...">
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<a class="btn btn-success mb-3" asp-action="CreateCategory">Add New Category</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Dishes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.DishCount</td>
                <td>
                    <a class="btn btn-primary" asp-action="EditCategory" asp-route-id="@category.Id">Edit</a>

                    @if (!category.IsArchived)
                    {
                        <a class="btn btn-warning"
                           asp-action="ArchiveCategory"
                           asp-route-id="@category.Id"
                           onclick="return confirmArchive(@category.DishCount)">
                            Archive
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-success"
                           asp-action="UnarchiveCategory"
                           asp-route-id="@category.Id"
                           onclick="return confirm('Are you sure you want to restore this category?')">
                            Unarchive
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Categories", new { search = ViewBag.SearchQuery, page = i })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
</div>

<script>
    function confirmArchive(dishCount) {
        return confirm(`Are you sure you want to archive this category? ${dishCount} dishes use this category.`);
    }
</script>
